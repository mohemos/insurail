# ------------------------------------------------------------------
# Insurail website — environment variables
# Copy to .env.local for local development. On Netlify, add these under
# Site configuration → Environment variables (Project settings).
# ------------------------------------------------------------------

# --- Lead delivery (server-side, used by /api/lead) -----------------
# In production at least one transport must be configured, otherwise
# the form returns an error and asks the visitor to email you instead.

# 1) Generic JSON webhook: Formspree, Zapier, Make, n8n, HubSpot, your CRM,
#    or your own endpoint. Receives {"lead": {...}, "meta": {...}} as JSON.
LEAD_WEBHOOK_URL=
# Optional. Sent as "Authorization: Bearer <secret>" with every webhook call.
LEAD_WEBHOOK_SECRET=

# 2) Resend (https://resend.com) — emails each lead to your inbox.
RESEND_API_KEY=
LEAD_NOTIFY_TO=hello@insurail.io
LEAD_NOTIFY_FROM="Insurail Website <leads@insurail.io>"

# --- Site -----------------------------------------------------------
# Canonical origin (no trailing slash). Used for metadata, sitemap and OG image URLs.
NEXT_PUBLIC_SITE_URL=https://insurail.io
# Developer docs link used by the "Read the docs" buttons.
NEXT_PUBLIC_DOCS_URL=https://docs.insurail.io

# --- Analytics (optional, cookie-free) ------------------------------
# Leave empty to disable analytics entirely (no script, no notice).
# Plausible: set to your site domain as registered in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: self-hosted Plausible script host (defaults to https://plausible.io).
NEXT_PUBLIC_PLAUSIBLE_HOST=
#
# Alternative with no code changes: Netlify Analytics reads server logs and is
# enabled from the Netlify dashboard (Site configuration → Analytics). It needs
# no client script and no environment variable here.
